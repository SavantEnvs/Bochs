vgaromimage: file=/mayhem/bochs/bios/VGABIOS-lgpl/VGABIOS-lgpl-latest.bin
pci: enabled=1, chipset=i440fx, slot1=e1000, slot2=pcipnic
e1000: enabled=1, mac=52:54:00:12:34:56, ethmod=null
pcipnic: enabled=1, mac=52:54:00:12:34:57, ethmod=null
ne2k: enabled=1, ioaddr=0x300, irq=9, mac=52:54:00:12:34:58, ethmod=null
memory: guest=16, host=16
display_library: nogui
log: /dev/null
panic: action=fatal
error: action=report
info: action=ignore
debug: action=ignore
sound: waveoutdrv=dummy, waveindrv=dummy, midioutdrv=dummy
mouse: enabled=0
clock: sync=none, time0=1
romimage: file=/mayhem/bochs/bios/BIOS-bochs-latest
