# Whole-emulator target: the fuzz input is the system ROM (romimage, given on
# the command line). Default PC devices, 32-bit + x86-64 CPU interpreter.
vgaromimage: file=/mayhem/bochs/bios/VGABIOS-lgpl/VGABIOS-lgpl-latest.bin
memory: guest=16, host=16
display_library: nogui
log: /dev/null
panic: action=fatal
error: action=report
info: action=ignore
debug: action=ignore
sound: waveoutdrv=dummy, waveindrv=dummy, midioutdrv=dummy
mouse: enabled=0
clock: sync=none, time0=1
